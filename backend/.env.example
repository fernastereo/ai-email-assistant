# Server
PORT=3001
NODE_ENV=production

# AI Provider — choose which LLM backend to use: openai | deepseek | groq (default: openai)
AI_PROVIDER=openai

# OpenAI — get your key at platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# DeepSeek — get your key at platform.deepseek.com (only needed if AI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=sk-...

# Groq — get your key at console.groq.com (only needed if AI_PROVIDER=groq)
GROQ_API_KEY=gsk_...

# CORS — set to your Chrome extension ID once published
# Format: chrome-extension://<extension-id>
# In development you can use * but never in production
CORS_ORIGIN=chrome-extension://your-extension-id
