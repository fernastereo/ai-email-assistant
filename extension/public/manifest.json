{
  "manifest_version": 3,
  "name": "Replie",
  "version": "1.0.0",
  "description": "Replie — AI email assistant for Gmail. Generate smart replies, summarize emails and detect sentiment in one click.",
  "permissions": [
    "contextMenus",
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "https://api.replie.email/*",
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*"
  ],
  "background": {
    "service_worker": "static/js/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*", 
        "https://outlook.live.com/*", 
        "https://outlook.office.com/*"
      ],
      "js": ["static/js/content-script.js"],
      "css": ["static/css/content-styles.css"],
      "type": "module"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "AI Email Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}